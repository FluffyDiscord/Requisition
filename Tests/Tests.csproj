<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ResolverTests</AssemblyName>
    <RootNamespace>TerraStorage.Tests</RootNamespace>
    <!-- Compile ONLY the pure resolver core + these tests: no Terraria, no rest of the mod. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Link the shipped core source directly, so the tests exercise the exact code, not a copy. -->
    <Compile Include="..\Helpers\Resolver\CoreModels.cs" />
    <Compile Include="..\Helpers\Resolver\CoreResolver.cs" />
    <!-- Which stacks a withdrawal or a defragment touches: the rule, without the NBT. -->
    <Compile Include="..\Common\StackSelection.cs" />
    <!-- What makes a stored stack its own item rather than so many units of a type. -->
    <Compile Include="..\Common\StackIdentity.cs" />
    <!-- Which stacks on a disk a donor could merge into, without asking the rule about all of them. -->
    <Compile Include="..\Common\MergeCandidateIndex.cs" />
    <!-- Deposit arithmetic: the pair of numbers a partial deposit has to keep straight. -->
    <Compile Include="..\Common\DepositOutcome.cs" />
    <!-- Crafting transaction core: item movement bookkeeping, Terraria-free so it can be faked. -->
    <Compile Include="..\Helpers\Resolver\CraftingTransaction.cs" />
    <!-- UI click arbitration: all three are Terraria-free precisely so they can be tested here. -->
    <Compile Include="..\Content\UI\WindowStackCore.cs" />
    <Compile Include="..\Content\UI\DepositGate.cs" />
    <Compile Include="..\Content\UI\UIClickBlocker.cs" />
    <Compile Include="..\Content\UI\FavoritesRowCache.cs" />
    <Compile Include="..\Content\UI\PanelRefreshCache.cs" />
    <Compile Include="FakeEnvironment.cs" />
    <Compile Include="FakeStorage.cs" />
    <Compile Include="HotPathBenchmarks.cs" />
    <Compile Include="Program.cs" />
    <!-- Scoped /tsdump slices: one scenario each, so a failure names the recipe that broke. -->
    <None Include="Fixtures\*.tsdump.txt" CopyToOutputDirectory="Always" />
  </ItemGroup>

</Project>
